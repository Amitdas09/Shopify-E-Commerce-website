{%- comment -%}
  Purelane — Why bundles beat buying single  (prototype: #whybundles)
{%- endcomment -%}

{%- render 'purelane-assets' -%}
{{ 'purelane-content.css' | asset_url | stylesheet_tag }}

{%- assign anchor = section.settings.anchor_id | default: 'whybundles' | handle -%}

<div
  class="purelane purelane-section"
  id="{{ anchor }}"
  data-purelane-scene="{{ section.settings.scene_depth }}"
  style="--pl-pt:{{ section.settings.padding_top }}px; --pl-pb:{{ section.settings.padding_bottom }}px;"
>
  <div class="wrap">
    <div class="glass sec-pad rv" data-purelane-reveal>
      {%- if section.settings.heading != blank -%}
        <div class="panel-head">
          {%- if section.settings.kicker != blank -%}
            <span class="kicker">{{ section.settings.kicker }}</span>
          {%- endif -%}
          <h2 class="d2">{{ section.settings.heading }}</h2>
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="wb">
          {%- for block in section.blocks -%}
            <div class="wb-i" {{ block.shopify_attributes }}>
              <span class="ci">{%- render 'purelane-icon', icon: block.settings.icon -%}</span>
              {%- if block.settings.heading != blank -%}
                <h3>{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- elsif request.design_mode -%}
        <p class="shelf-empty">Add a reason to get started.</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Purelane why bundles",
  "tag": "section",
  "class": "purelane-shell",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The smarter way to shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why bundles beat buying single" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "whybundles" },
    { "type": "range", "id": "scene_depth", "label": "Background depth", "min": 1, "max": 4, "step": 1, "default": 4 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 34 }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "check", "label": "Check" },
            { "value": "truck", "label": "Delivery" },
            { "value": "no-chem", "label": "No chemicals" }
          ],
          "default": "check"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Save up to 45%" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Versus buying the same products separately" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane why bundles",
      "blocks": [
        { "type": "reason", "settings": { "icon": "check", "heading": "Save up to 45%", "text": "Versus buying the same products separately" } },
        { "type": "reason", "settings": { "icon": "shield", "heading": "One flat price", "text": "No calculators, no comparing carts" } },
        { "type": "reason", "settings": { "icon": "leaf", "heading": "Curated by experts", "text": "Products picked to work well together" } },
        { "type": "reason", "settings": { "icon": "truck", "heading": "Free shipping always", "text": "Included on every bundle, all India" } }
      ]
    }
  ]
}
{% endschema %}
