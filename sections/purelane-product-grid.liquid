{%- comment -%}
  Purelane — Shop / product grid  (prototype: #shop)

  Source is merchant-controlled: a collection, or a hand-picked product list for
  a curated shelf. Everything else on the card comes from the product object.
{%- endcomment -%}

{%- render 'purelane-assets' -%}
{{ 'purelane-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign anchor = section.settings.anchor_id | default: 'shop' | handle

  if section.settings.source == 'picked'
    assign items = section.settings.products
  else
    assign items = section.settings.collection.products
  endif

  assign limit = section.settings.products_to_show
-%}

<div
  class="purelane purelane-section purelane-product-grid"
  id="{{ anchor }}"
  data-purelane-scene="{{ section.settings.scene_depth }}"
  style="--shelf-cols:{{ section.settings.columns_desktop }};
         --pl-pt:{{ section.settings.padding_top }}px;
         --pl-pb:{{ section.settings.padding_bottom }}px;"
>
  <div class="wrap">
    {%- if section.settings.kicker != blank or section.settings.heading != blank -%}
      <div class="panel-head rv" data-purelane-reveal>
        {%- if section.settings.kicker != blank -%}
          <span class="kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="d2">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.show_rule -%}
          <div class="rule">
            <i></i>
            {%- render 'purelane-icon', icon: 'leaf' -%}
            <i></i>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="shelf">
      {%- if items.size > 0 -%}
        {%- for product in items limit: limit -%}
          {%- liquid
            assign delay = forloop.index0 | modulo: 5
            assign rc = 'rv'
            if delay > 0
              assign rc = 'rv rv-d' | append: delay
            endif
          -%}
          {%- render 'purelane-product-card',
            product: product,
            reveal_class: rc,
            show_rating: section.settings.show_rating,
            heading_tag: 'h3'
          -%}
        {%- endfor -%}

      {%- elsif request.design_mode -%}
        <p class="shelf-empty">
          No products yet. Pick a collection or add products in the section settings.
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Purelane shop grid",
  "tag": "section",
  "class": "purelane-shell",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show leaf divider",
      "default": true
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "options": [
        { "value": "collection", "label": "Collection" },
        { "value": "picked", "label": "Hand-picked products" }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Used when source is Collection."
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 12,
      "info": "Used when source is Hand-picked."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "info": "Mobile is always 2 columns, matching the design."
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true,
      "info": "Reads the standard reviews.rating metafields. Hidden automatically on products with no reviews."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "shop",
      "info": "Other sections link here with #shop. Change both if you rename it."
    },
    {
      "type": "range",
      "id": "scene_depth",
      "label": "Background depth",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "info": "How deep underwater the animated backdrop sits behind this section. 1 is the surface."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 34
    }
  ],
  "presets": [
    {
      "name": "Purelane shop grid"
    }
  ]
}
{% endschema %}
