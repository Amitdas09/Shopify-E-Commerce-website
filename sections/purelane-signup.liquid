{%- comment -%}
  Purelane — newsletter signup.

  The prototype's form was onsubmit="return false" — it looked like a signup and
  did nothing. This posts to Shopify's real customer form, so the address lands
  in the customer list tagged as a newsletter subscriber, and it reports success
  and errors instead of silently swallowing them.
{%- endcomment -%}

{%- render 'purelane-assets' -%}
{{ 'purelane-content.css' | asset_url | stylesheet_tag }}

<div
  class="purelane purelane-section"
  data-purelane-scene="{{ section.settings.scene_depth }}"
  style="--pl-pt:{{ section.settings.padding_top }}px; --pl-pb:{{ section.settings.padding_bottom }}px;"
>
  <div class="wrap">
    <div class="glass signup rv" data-purelane-reveal>
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="d2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="lede">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'pl-signup', class: 'signup-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">

        <label class="visually-hidden" for="pl-email-{{ section.id }}">Email address</label>
        <input
          id="pl-email-{{ section.id }}"
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.placeholder | escape }}"
          autocomplete="email"
          required
        >

        <button class="btn btn-primary" type="submit">{{ section.settings.button_label }}</button>

        {%- if form.posted_successfully? -%}
          <p class="form-msg" role="status">{{ section.settings.success_text }}</p>
        {%- elsif form.errors -%}
          <p class="form-err" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Purelane signup",
  "tag": "section",
  "class": "purelane-shell",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Join the Purelane Club" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get ₹100 off your first bundle" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Plus first access to new launches and restocks." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "your@email.com" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Get my ₹100 off" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks. Check your inbox for the code." },
    { "type": "range", "id": "scene_depth", "label": "Background depth", "min": 1, "max": 4, "step": 1, "default": 4 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 34 }
  ],
  "presets": [{ "name": "Purelane signup" }]
}
{% endschema %}
