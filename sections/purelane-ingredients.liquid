{%- comment -%}
  Purelane — Sourced from nature  (prototype: #ingredients)

  Each ingredient is a block. The art is either one of the five botanical
  drawings from the design, or a merchant-uploaded image — so a new ingredient
  does not need a developer.
{%- endcomment -%}

{%- render 'purelane-assets' -%}
{{ 'purelane-content.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign anchor = section.settings.anchor_id | default: 'ingredients' | handle
  assign cols = section.blocks.size
  if cols > 5
    assign cols = 5
  endif
-%}

<div
  class="purelane purelane-section"
  id="{{ anchor }}"
  data-purelane-scene="{{ section.settings.scene_depth }}"
  style="--pl-pt:{{ section.settings.padding_top }}px; --pl-pb:{{ section.settings.padding_bottom }}px;"
>
  <div class="wrap">
    <div class="glass sec-pad rv" data-purelane-reveal>
      {%- if section.settings.heading != blank -%}
        <div class="panel-head">
          {%- if section.settings.kicker != blank -%}
            <span class="kicker">{{ section.settings.kicker }}</span>
          {%- endif -%}
          <h2 class="d2">{{ section.settings.heading }}</h2>
          {%- if section.settings.show_rule -%}
            <div class="rule"><i></i>{%- render 'purelane-icon', icon: 'leaf' -%}<i></i></div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="ing" style="--ing-cols:{{ cols }}">
          {%- for block in section.blocks -%}
            <div class="ing-i" {{ block.shopify_attributes }}>
              <div class="art">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 200 | image_tag: alt: block.settings.name, loading: 'lazy' }}
                {%- else -%}
                  {%- render 'purelane-botanical', art: block.settings.art -%}
                {%- endif -%}
              </div>
              {%- if block.settings.name != blank -%}
                <h3>{{ block.settings.name }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- elsif request.design_mode -%}
        <p class="shelf-empty">Add an ingredient to get started.</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Purelane ingredients",
  "tag": "section",
  "class": "purelane-shell",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sourced from nature" },
    { "type": "checkbox", "id": "show_rule", "label": "Show leaf divider", "default": true },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "ingredients" },
    { "type": "range", "id": "scene_depth", "label": "Background depth", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 34 }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "select",
          "id": "art",
          "label": "Illustration",
          "options": [
            { "value": "coconut", "label": "Coconut" },
            { "value": "orange-peel", "label": "Orange peel" },
            { "value": "soap-nut", "label": "Soap nut" },
            { "value": "neem", "label": "Neem" },
            { "value": "lemongrass", "label": "Lemongrass" }
          ],
          "default": "coconut"
        },
        { "type": "image_picker", "id": "image", "label": "Custom image", "info": "Overrides the illustration." },
        { "type": "text", "id": "name", "label": "Name", "default": "Coconut" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Plant-derived cleansers that lift grease" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "art": "coconut", "name": "Coconut", "text": "Plant-derived cleansers that lift grease" } },
        { "type": "ingredient", "settings": { "art": "orange-peel", "name": "Orange peel", "text": "Natural degreaser and fresh citrus lift" } },
        { "type": "ingredient", "settings": { "art": "soap-nut", "name": "Soap nut", "text": "A traditional plant foaming agent" } },
        { "type": "ingredient", "settings": { "art": "neem", "name": "Neem", "text": "Time-tested antibacterial from the tree" } },
        { "type": "ingredient", "settings": { "art": "lemongrass", "name": "Lemongrass", "text": "Clean fragrance with nothing synthetic" } }
      ]
    }
  ]
}
{% endschema %}
