{%- comment -%}
  Purelane — Why it works  (prototype: #proof)

  Copy panel, a rotating product showcase, and a stat strip.

  The prototype marked the whole rotator aria-hidden="true" and then put the
  product name and its benefit line inside it — so that copy existed for sighted
  visitors only. Here the caption is a live region and the products are real.
{%- endcomment -%}

{%- render 'purelane-assets' -%}
{{ 'purelane-content.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign anchor = section.settings.anchor_id | default: 'proof' | handle
  assign items = section.settings.products
  assign stats = section.blocks | where: 'type', 'stat'
-%}

{%- comment -%}
  Captions travel as one JSON array rather than a data attribute per image.
  image_tag cannot take a hyphenated argument name — Liquid reads `data-note`
  as a subtraction — and this keeps the benefit lines in one place.
{%- endcomment -%}
{%- capture rotator_notes -%}
[{% for product in items limit: 8 %}{{ product.metafields.purelane.benefit.value | default: '' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]
{%- endcapture -%}

<div
  class="purelane purelane-section"
  id="{{ anchor }}"
  data-purelane-scene="{{ section.settings.scene_depth }}"
  style="--pl-pt:{{ section.settings.padding_top }}px; --pl-pb:{{ section.settings.padding_bottom }}px;"
>
  <div class="wrap">
    <div class="glass sec-pad rv" data-purelane-reveal>
      <div class="proof">
        <div class="proof-l">
          {%- if section.settings.kicker != blank -%}
            <span class="kicker">{{ section.settings.kicker }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="d2">{{ section.settings.heading | newline_to_br }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="body-s">{{ section.settings.text }}</p>
          {%- endif -%}
          {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
            <a class="btn btn-primary" href="{{ section.settings.button_link }}">
              {{ section.settings.button_label }}
              {%- render 'purelane-icon', icon: 'arrow' -%}
            </a>
          {%- endif -%}
        </div>

        {%- if items.size > 0 -%}
          <purelane-rotator
            class="glass-2 rot"
            data-interval="{{ section.settings.rotate_seconds }}"
            data-notes="{{ rotator_notes | escape }}"
            role="group"
            aria-roledescription="carousel"
            aria-label="{{ section.settings.rotator_label | escape }}"
          >
            <div class="frame">
              {%- for product in items limit: 8 -%}
                {%- liquid
                  assign rot_class = ''
                  if forloop.first
                    assign rot_class = 'on'
                  endif
                -%}
                {%- render 'purelane-product-image',
                  product: product,
                  class: rot_class,
                  sizes: '196px' -%}
              {%- endfor -%}
            </div>

            <p class="cap" aria-live="polite">
              <b data-rot-name>{{ items.first.title }}</b>
              <span data-rot-note>{{ items.first.metafields.purelane.benefit.value }}</span>
            </p>

            {%- if items.size > 1 -%}
              <div class="dots">
                {%- for product in items limit: 8 -%}
                  <button
                    type="button"
                    class="{% if forloop.first %}on{% endif %}"
                    data-rot-goto="{{ forloop.index0 }}"
                    aria-label="Show {{ product.title | escape }}"
                    {% if forloop.first %}aria-current="true"{% endif %}
                  ></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </purelane-rotator>
        {%- endif -%}

        {%- if stats.size > 0 -%}
          <div class="glass-2 stats">
            {%- for block in stats -%}
              <div class="stat" {{ block.shopify_attributes }}>
                {%- if block.settings.figure != blank -%}
                  <p class="ring">{{ block.settings.figure }}</p>
                {%- endif -%}
                {%- if block.settings.label != blank -%}
                  <h3>{{ block.settings.label }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p>{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script src="{{ 'purelane-rotator.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Purelane proof",
  "tag": "section",
  "class": "purelane-shell",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Why it works" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Tough on grime.\nGentle on everything else." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Every formula is built on plant-derived cleansers and essential oils. It behaves exactly like the cleaner you are used to, minus the things you never signed up for."
    },
    { "type": "text", "id": "button_label", "label": "Button", "default": "See the ingredient list" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Rotator" },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 8,
      "info": "The caption uses each product's purelane.benefit metafield."
    },
    { "type": "text", "id": "rotator_label", "label": "Rotator label for screen readers", "default": "Purelane products" },
    {
      "type": "range",
      "id": "rotate_seconds",
      "label": "Seconds per product",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 3,
      "info": "0 turns rotation off. Never runs for visitors who prefer reduced motion."
    },
    { "type": "header", "content": "Layout" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "proof" },
    { "type": "range", "id": "scene_depth", "label": "Background depth", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 34 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "figure", "label": "Figure", "default": "99.9%" },
        { "type": "text", "id": "label", "label": "Label", "default": "Germ kill" },
        { "type": "text", "id": "text", "label": "Text", "default": "Tested against germs and bacteria" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane proof",
      "blocks": [
        { "type": "stat", "settings": { "figure": "99.9%", "label": "Germ kill", "text": "Tested against germs and bacteria" } },
        { "type": "stat", "settings": { "figure": "0%", "label": "Sulphates", "text": "No SLS, chlorine or parabens" } },
        { "type": "stat", "settings": { "figure": "100%", "label": "Plant based", "text": "Cleansers derived from plants" } },
        { "type": "stat", "settings": { "figure": "4.8", "label": "Rated", "text": "Across 8,000+ verified reviews" } }
      ]
    }
  ]
}
{% endschema %}
