{%- comment -%}
  Purelane — three value pillars  (prototype: #how)
{%- endcomment -%}

{%- render 'purelane-assets' -%}
{{ 'purelane-content.css' | asset_url | stylesheet_tag }}

{%- assign anchor = section.settings.anchor_id | default: 'how' | handle -%}

<div
  class="purelane purelane-section"
  id="{{ anchor }}"
  data-purelane-scene="{{ section.settings.scene_depth }}"
  style="--pl-pt:{{ section.settings.padding_top }}px; --pl-pb:{{ section.settings.padding_bottom }}px;"
>
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div class="panel-head rv" data-purelane-reveal>
        {%- if section.settings.kicker != blank -%}
          <span class="kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        <h2 class="d2">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="pillars">
        {%- for block in section.blocks -%}
          {%- liquid
            assign rc = 'rv'
            if forloop.index0 > 0
              assign rc = 'rv rv-d' | append: forloop.index0
            endif
          -%}
          <article class="glass pillar {{ rc }}" data-purelane-reveal {{ block.shopify_attributes }}>
            <span class="pi">{%- render 'purelane-icon', icon: block.settings.icon -%}</span>
            {%- if block.settings.heading != blank -%}
              <h3 class="d3">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="body-s">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
              <a class="btn btn-ghost btn-sm" href="{{ block.settings.button_link }}">
                {{ block.settings.button_label }}
                <span class="visually-hidden">about {{ block.settings.heading }}</span>
              </a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="shelf-empty">Add a pillar to get started.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Purelane pillars",
  "tag": "section",
  "class": "purelane-shell",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "how" },
    { "type": "range", "id": "scene_depth", "label": "Background depth", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 34 }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "no-chem", "label": "No chemicals" },
            { "value": "truck", "label": "Delivery" },
            { "value": "check", "label": "Check" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Less scrubbing" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub." },
        { "type": "text", "id": "button_label", "label": "Button", "default": "Learn more" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane pillars",
      "blocks": [
        { "type": "pillar", "settings": { "icon": "leaf", "heading": "Less scrubbing", "text": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub." } },
        { "type": "pillar", "settings": { "icon": "shield", "heading": "Clean ingredients", "text": "No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food." } },
        { "type": "pillar", "settings": { "icon": "no-chem", "heading": "Safe around everyone", "text": "Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day." } }
      ]
    }
  ]
}
{% endschema %}
