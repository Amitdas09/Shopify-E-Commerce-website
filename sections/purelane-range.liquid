{%- comment -%}
  Purelane — the full range shelf  (prototype: #range)

  A horizontal strip of every product, alternating heights. Scrolls on mobile,
  so it takes tabindex and a label like the other rails.
{%- endcomment -%}

{%- render 'purelane-assets' -%}
{{ 'purelane-content.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign anchor = section.settings.anchor_id | default: 'range' | handle
  if section.settings.source == 'picked'
    assign items = section.settings.products
  else
    assign items = section.settings.collection.products
  endif
-%}

<div
  class="purelane purelane-section"
  id="{{ anchor }}"
  data-purelane-scene="{{ section.settings.scene_depth }}"
  style="--pl-pt:{{ section.settings.padding_top }}px; --pl-pb:{{ section.settings.padding_bottom }}px;"
>
  <div class="wrap">
    <div class="glass range rv" data-purelane-reveal>
      <div class="range-head">
        <div>
          {%- if section.settings.kicker != blank -%}
            <span class="kicker">{{ section.settings.kicker }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="d2">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
        {%- if section.settings.text != blank -%}
          <p class="body-s">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      {%- if items.size > 0 -%}
        <div
          class="stripwrap"
          role="region"
          aria-label="{{ section.settings.heading | default: 'Full range' | escape }}, scrollable"
          tabindex="0"
        >
          <div class="rangerow">
            {%- for product in items limit: section.settings.products_to_show -%}
              <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                {%- render 'purelane-product-image', product: product, sizes: '132px' -%}
              </a>
            {%- endfor -%}
          </div>
        </div>
        {%- if section.settings.hint != blank -%}
          <p class="striphint">{{ section.settings.hint }}</p>
        {%- endif -%}
      {%- elsif request.design_mode -%}
        <p class="shelf-empty">Pick a collection or hand-pick products in the section settings.</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Purelane full range",
  "tag": "section",
  "class": "purelane-shell",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The full range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every room, one shelf" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Floors, taps, kitchen, laundry, bathroom and hands. Plant-based formulas that replace every harsh bottle under your sink."
    },
    { "type": "text", "id": "hint", "label": "Mobile hint", "default": "Swipe to see the full shelf" },
    { "type": "header", "content": "Products" },
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "options": [
        { "value": "collection", "label": "Collection" },
        { "value": "picked", "label": "Hand-picked products" }
      ],
      "default": "collection"
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 16 },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 16, "step": 1, "default": 10 },
    { "type": "header", "content": "Layout" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "range" },
    { "type": "range", "id": "scene_depth", "label": "Background depth", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 34 }
  ],
  "presets": [{ "name": "Purelane full range" }]
}
{% endschema %}
