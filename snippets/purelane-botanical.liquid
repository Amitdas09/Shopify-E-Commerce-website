{%- comment -%}
  Botanical line art for the ingredients section, lifted verbatim from the
  prototype so the drawings are identical.

  The prototype recoloured these with attribute selectors in a second
  stylesheet -- [stroke="#f0a03c"] { stroke:#b8701c } and friends -- which
  only worked because the V1 colours were still sitting in the markup. The
  resolved colours are baked in here instead.

  Param: art - coconut | orange-peel | soap-nut | neem | lemongrass
{%- endcomment -%}

{%- case art -%}
  {%- when 'coconut' -%}
    <svg aria-hidden="true" focusable="false" viewBox="0 0 100 100" fill="none" stroke="#0d5b52" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> <circle cx="50" cy="62" r="25"/> <path d="M31 53c9-6 29-6 38 0" stroke="#b8701c"/> <path d="M41 63c4 8 14 8 18 0" opacity=".55"/> <path d="M50 37V25"/> <path d="M50 27C42 18 30 16 21 21c5 10 17 13 29 6Z" stroke="#b8701c"/> <path d="M50 27c8-9 20-11 29-6-5 10-17 13-29 6Z" stroke="#b8701c"/> </svg>
  {%- when 'orange-peel' -%}
    <svg aria-hidden="true" focusable="false" viewBox="0 0 100 100" fill="none" stroke="#0d5b52" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> <circle cx="45" cy="58" r="23"/> <path d="M45 35v46M22 58h46" opacity=".4"/> <path d="M29 42 61 74M61 42 29 74" opacity=".26"/> <path d="M62 28c13-1 20 10 15 20-4 8-15 9-19 2" stroke="#b8701c"/> <path d="M45 34c-3-8 2-15 10-16 1 9-3 15-10 16Z" stroke="#b8701c"/> </svg>
  {%- when 'soap-nut' -%}
    <svg aria-hidden="true" focusable="false" viewBox="0 0 100 100" fill="none" stroke="#0d5b52" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> <circle cx="36" cy="66" r="16"/> <circle cx="64" cy="69" r="14"/> <circle cx="50" cy="43" r="14"/> <path d="M50 29V17"/> <path d="M50 21c-8-8-18-8-23-2 7 8 17 10 23 2Z" stroke="#b8701c"/> <path d="M31 60a5 5 0 0 1 4-4" opacity=".6"/> <path d="M46 38a5 5 0 0 1 4-4" opacity=".6"/> </svg>
  {%- when 'neem' -%}
    <svg aria-hidden="true" focusable="false" viewBox="0 0 100 100" fill="none" stroke="#0d5b52" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> <path d="M18 82C36 66 58 44 82 20" stroke="#b8701c"/> <path d="M27 73c-6-7-4-15 3-18 4 7 3 14-3 18Z"/> <path d="M31 69c8-4 15 0 16 8-8 2-14-1-16-8Z"/> <path d="M41 59c-6-7-4-16 3-19 4 7 3 15-3 19Z"/> <path d="M45 55c9-4 16 0 17 8-8 2-15-1-17-8Z"/> <path d="M56 44c-6-7-4-16 3-19 4 7 3 15-3 19Z"/> <path d="M60 40c9-4 16 0 17 8-8 2-15-1-17-8Z"/> <path d="M70 30c-5-7-3-15 4-18 3 7 2 14-4 18Z"/> </svg>
  {%- when 'lemongrass' -%}
